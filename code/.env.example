# Copy to .env and fill in. Nothing here is committed (.env is gitignored).

# Razorpay TEST-mode keys (dashboard -> Settings -> API Keys, in Test Mode).
# Leave blank to run with labelled MOCK orders; set them for the real submission.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LLM brain: auto | anthropic | offline   (auto = use Claude if a key is set)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Failure-handling knobs
MAX_RETRIES=2
RETRY_BASE_DELAY_SEC=0.5
